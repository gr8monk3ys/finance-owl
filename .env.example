# ===========================================
# FinanceOwl Environment Configuration
# ===========================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_owl

# Authentication
# IMPORTANT: Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (for Plaid tokens, TOTP secrets at rest)
# IMPORTANT: Must be exactly 64 hex characters (256-bit key). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_must_be_64_hex_chars

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://your-domain.com/api/webhooks/plaid

# Bank Aggregator Default (plaid | mx | finicity)
BANK_AGGREGATOR_DEFAULT=plaid

# MX (optional — enables MX as a bank aggregator)
MX_API_KEY=
MX_CLIENT_ID=
MX_ENV=sandbox

# Finicity / Mastercard Open Banking (optional)
FINICITY_APP_KEY=
FINICITY_PARTNER_ID=
FINICITY_PARTNER_SECRET=
FINICITY_ENV=sandbox

# Credit Bureau Providers (optional — falls back to simulated data)
TRANSUNION_API_KEY=
TRANSUNION_PARTNER_ID=
EQUIFAX_API_KEY=
EQUIFAX_CLIENT_ID=
EXPERIAN_API_KEY=
EXPERIAN_CLIENT_ID=

# Banking-as-a-Service: Unit.co (optional - banking features degrade gracefully)
UNIT_API_TOKEN=
UNIT_ORG_ID=
UNIT_API_URL=https://api.s.unit.sh

# Banking-as-a-Service: Treasury Prime (optional - banking features degrade gracefully)
TREASURY_PRIME_API_KEY=
TREASURY_PRIME_ACCOUNT_ID=
TREASURY_PRIME_API_URL=https://api.treasuryprime.com

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# AI (optional - features degrade gracefully)
OLLAMA_URL=http://localhost:11434
CHROMADB_URL=http://localhost:8000

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:3000

# Production
DOMAIN=localhost
PORT=80
HTTPS_PORT=443

# WebAuthn
WEBAUTHN_RP_NAME=FinanceOwl
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...
STRIPE_PRICE_FAMILY_MONTHLY=price_...
STRIPE_PRICE_FAMILY_YEARLY=price_...

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinanceOwl <noreply@financeowl.com>

# Identity Monitoring (HaveIBeenPwned)
HIBP_API_KEY=

# Sentry Error Monitoring (optional - everything works without it)
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_BACKEND=
SENTRY_PROJECT_FRONTEND=
