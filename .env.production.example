# ===========================================
# FinanceOwl Production Environment Variables
# ===========================================
# Copy to .env.production and fill in actual values.
# For Railway, set these as Service Variables in the dashboard.
# For Vercel, set these in the project Environment Variables settings.

# ──────────────────────────────────────────
# Database (Railway provides this automatically via PostgreSQL plugin)
# ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/finance_owl?sslmode=require
DATABASE_SSL=true

# ──────────────────────────────────────────
# Redis (Railway provides this automatically via Redis plugin)
# ──────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ──────────────────────────────────────────
# Authentication
# Generate with: openssl rand -base64 48
# ──────────────────────────────────────────
JWT_SECRET=generate-a-strong-secret-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-a-different-strong-secret-with-openssl-rand-base64-48
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ──────────────────────────────────────────
# Encryption (for Plaid tokens, TOTP secrets at rest)
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (256-bit key)
# ──────────────────────────────────────────
ENCRYPTION_KEY=generate-a-64-char-hex-string-with-openssl-rand-hex-32

# Master secret for envelope encryption — minimum 32 characters
# Generate with: openssl rand -base64 48
ENCRYPTION_MASTER_SECRET=

# ──────────────────────────────────────────
# Plaid (bank account linking)
# ──────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_WEBHOOK_URL=https://api.yourapp.com/api/webhooks/plaid

# ──────────────────────────────────────────
# Stripe Billing
# ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...
STRIPE_PRICE_FAMILY_MONTHLY=price_...
STRIPE_PRICE_FAMILY_YEARLY=price_...

# ──────────────────────────────────────────
# Sentry Error Monitoring
# ──────────────────────────────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_BACKEND=
SENTRY_PROJECT_FRONTEND=

# ──────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinanceOwl <noreply@yourapp.com>

# ──────────────────────────────────────────
# WebAuthn (passkey authentication)
# ──────────────────────────────────────────
WEBAUTHN_RP_NAME=FinanceOwl
WEBAUTHN_RP_ID=yourapp.com
WEBAUTHN_ORIGIN=https://yourapp.com

# ──────────────────────────────────────────
# Web Push Notifications
# Generate with: npx web-push generate-vapid-keys
# ──────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourapp.com

# ──────────────────────────────────────────
# App Configuration
# ──────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://yourapp.com
BACKEND_URL=https://api.yourapp.com
CORS_ORIGIN=https://yourapp.com
LOG_LEVEL=warn

# ──────────────────────────────────────────
# Optional: Bank Aggregator Alternatives
# ──────────────────────────────────────────
# BANK_AGGREGATOR_DEFAULT=plaid
# MX_API_KEY=
# MX_CLIENT_ID=
# MX_ENV=production
# FINICITY_APP_KEY=
# FINICITY_PARTNER_ID=
# FINICITY_PARTNER_SECRET=
# FINICITY_ENV=production

# ──────────────────────────────────────────
# Optional: Credit Bureau Providers
# ──────────────────────────────────────────
# TRANSUNION_API_KEY=
# TRANSUNION_PARTNER_ID=
# EQUIFAX_API_KEY=
# EQUIFAX_CLIENT_ID=
# EXPERIAN_API_KEY=
# EXPERIAN_CLIENT_ID=

# ──────────────────────────────────────────
# Optional: Banking-as-a-Service
# ──────────────────────────────────────────
# UNIT_API_TOKEN=
# UNIT_ORG_ID=
# UNIT_API_URL=https://api.unit.co
# TREASURY_PRIME_API_KEY=
# TREASURY_PRIME_ACCOUNT_ID=
# TREASURY_PRIME_API_URL=https://api.treasuryprime.com

# ──────────────────────────────────────────
# Optional: Identity Monitoring
# ──────────────────────────────────────────
# HIBP_API_KEY=
