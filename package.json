{
  "name": "finance-owl",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first, self-hosted personal finance manager",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:setup": "node ./scripts/dev.mjs --setup-only",
    "dev:turbo": "turbo dev",
    "launch:check": "node ./scripts/check-launch-readiness.mjs",
    "launch:verify": "node ./scripts/check-launch-readiness.mjs --verify",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,svelte,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,svelte,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^10.9.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.1.1",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "cookie": ">=0.7.0 <2",
    "esbuild": ">=0.28.1",
    "tar": ">=7.5.21",
    "ajv": ">=8.18.0",
    "minimatch": ">=3.1.4",
    "shell-quote": ">=1.9.0",
    "node-forge": ">=1.4.0",
    "lodash": ">=4.18.0",
    "axios": ">=1.18.0",
    "@xmldom/xmldom": ">=0.9.12",
    "multer": ">=2.3.0",
    "follow-redirects": ">=1.16.0",
    "@opentelemetry/core": ">=2.8.0",
    "@babel/core": ">=7.29.6 <8",
    "uuid": ">=11.1.1",
    "brace-expansion": ">=5.0.9",
    "path-to-regexp": ">=8.4.0",
    "postcss": ">=8.5.23",
    "nanoid": ">=3.3.18",
    "qs": ">=6.16.0",
    "undici": ">=6.28.0",
    "body-parser": ">=2.3.0",
    "flatted": ">=3.4.2",
    "picomatch": ">=4.0.4",
    "vite": ">=6.4.3",
    "ws": ">=8.21.0",
    "js-yaml": ">=4.3.1",
    "form-data": ">=4.0.6",
    "@eslint/eslintrc": {
      "ajv": "^6.12.6"
    },
    "eslint": {
      "ajv": "^6.12.6"
    },
    "baseline-browser-mapping": ">=2.11.0",
    "browserslist": ">=4.28.7",
    "decode-uri-component": ">=0.5.0",
    "fast-uri": ">=4.1.3"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "@sentry/cli",
    "sharp"
  ]
}
