{
  "name": "finance-owl",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first, self-hosted personal finance manager",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:setup": "node ./scripts/dev.mjs --setup-only",
    "dev:turbo": "turbo dev",
    "launch:check": "node ./scripts/check-launch-readiness.mjs",
    "launch:verify": "node ./scripts/check-launch-readiness.mjs --verify",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,svelte,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,svelte,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "cookie": ">=0.7.0",
    "esbuild": ">=0.25.0",
    "tar": ">=7.5.11",
    "ajv": ">=8.18.0",
    "minimatch": ">=3.1.4"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "esbuild": ">=0.25.0",
      "ajv": ">=8.18.0",
      "cookie": ">=0.7.0",
      "minimatch": ">=3.1.4"
    }
  }
}
