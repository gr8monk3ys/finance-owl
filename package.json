{
  "name": "finance-owl",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first, self-hosted personal finance manager",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:setup": "node ./scripts/dev.mjs --setup-only",
