{
  "name": "finance-owl",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first, self-hosted personal finance manager",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:setup": "node ./scripts/dev.mjs --setup-only",
    "dev:turbo": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,svelte,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,svelte,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "cookie": ">=0.7.0",
    "esbuild": ">=0.25.0",
    "tar": ">=7.5.7"
  }
}
