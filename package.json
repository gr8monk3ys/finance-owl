    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,svelte,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,svelte,json,md,css}\""
  },
