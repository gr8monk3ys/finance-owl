# Core runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=warn

# Database and cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_owl
REDIS_URL=redis://localhost:6379

# Web origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-48-byte-base64-secret
JWT_REFRESH_SECRET=replace-with-a-48-byte-base64-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
# ENCRYPTION_KEY: openssl rand -hex 32
# ENCRYPTION_MASTER_SECRET: openssl rand -base64 48
ENCRYPTION_KEY=replace-with-a-64-character-hex-key
ENCRYPTION_MASTER_SECRET=replace-with-a-48-byte-base64-secret

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
# In production this MUST be set explicitly; webhook signature verification
# always runs in production and is only skipped in dev when PLAID_ENV is
# unset or 'sandbox'.
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# Optional bank data providers
MX_API_KEY=
MX_CLIENT_ID=
MX_ENV=sandbox
FINICITY_APP_KEY=
FINICITY_PARTNER_ID=
FINICITY_PARTNER_SECRET=
FINICITY_ENV=sandbox

# Optional banking partners
UNIT_API_TOKEN=
UNIT_ORG_ID=
UNIT_API_URL=https://api.s.unit.sh
TREASURY_PRIME_API_KEY=
TREASURY_PRIME_ACCOUNT_ID=
TREASURY_PRIME_API_URL=https://api.treasuryprime.com

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Finance Owl <noreply@financeowl.com>

# WebAuthn / passkeys
WEBAUTHN_RP_NAME=Finance Owl
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# AI services
OLLAMA_URL=http://localhost:11434
CHROMADB_URL=http://localhost:8000

# Monitoring
SENTRY_DSN=
SENTRY_RELEASE=

# E2E test escape hatch: set to 1 ONLY for local/CI end-to-end test runs.
# Never set this in production.
# DISABLE_RATE_LIMITING=1
