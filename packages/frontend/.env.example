# Backend API URL used by SvelteKit server routes.
API_URL=http://localhost:4000

# Public site URL used for sitemap, security.txt, legal links, and store listing support links.
PUBLIC_SITE_URL=http://localhost:3000

# Public company/contact details shown on support and legal pages.
PUBLIC_COMPANY_NAME=Finance Owl
PUBLIC_LEGAL_ENTITY_NAME=Finance Owl
PUBLIC_COMPANY_ADDRESS=
PUBLIC_SUPPORT_EMAIL=support@financeowl.com
PUBLIC_PRIVACY_EMAIL=privacy@financeowl.com
PUBLIC_LEGAL_EMAIL=legal@financeowl.com
PUBLIC_SECURITY_EMAIL=security@financeowl.com

# Optional Sentry browser DSN and release tag.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_RELEASE=
