{
  "name": "@finance-owl/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts --workers=1",
    "test:e2e:critical": "playwright test e2e/auth.spec.ts e2e/smoke.spec.ts --project=chromium --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "quality:lighthouse": "node ./scripts/check-lighthouse.mjs"
  },
  "dependencies": {
    "@finance-owl/shared": "workspace:*",
    "@sentry/sveltekit": "^10.70.0",
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.55.7",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
