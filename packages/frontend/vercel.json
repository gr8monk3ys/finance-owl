{
  "framework": "sveltekit",
  "buildCommand": "cd ../.. && bun run --filter @finance-owl/shared build && bun run --filter @finance-owl/frontend build",
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "outputDirectory": ".svelte-kit/output",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_app/immutable/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
