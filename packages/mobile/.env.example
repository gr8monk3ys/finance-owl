# Base URL for the FinanceOwl backend API.
# iOS simulator can use localhost. Android emulator should use 10.0.2.2.
# Physical devices and production builds should use an HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Public web URL for opening legal pages and web-only settings from the app.
EXPO_PUBLIC_WEB_URL=https://app.example.com

# Expo account owner for EAS builds.
EXPO_OWNER=your-expo-account

# EAS project ID returned by `npx eas-cli init`.
EXPO_PROJECT_ID=00000000-0000-0000-0000-000000000000

# App Store Connect numeric app ID for TestFlight submissions.
EXPO_ASC_APP_ID=1234567890
