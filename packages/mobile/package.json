{
  "name": "@finance-owl/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:expo": "npx expo-doctor",
    "release:check": "node ./scripts/check-release-readiness.mjs",
    "prebuild": "expo prebuild",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "build:production:ios": "npx eas-cli build --platform ios --profile production",
    "build:production:ios:ci": "npx eas-cli build --platform ios --profile production --non-interactive",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "submit:ios:ci": "npx eas-cli submit --platform ios --profile production --non-interactive",
    "testflight": "npx testflight",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@sentry/react-native": "^6.22.0",
    "expo": "~52.0.49",
    "expo-constants": "~17.0.8",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "^15.0.2",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~18.3.28",
    "babel-plugin-module-resolver": "^5.0.3",
    "typescript": "~5.6.3"
  }
}
